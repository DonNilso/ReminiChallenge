# Copy to .env.local and fill in. Never commit .env.local.

# URL of your deployed Modal app (printed by `modal deploy modal/restyle.py`), no trailing slash.
# Example: https://your-workspace--creator-studio-restyler-web.modal.run
MODAL_ENDPOINT_URL=

# Modal proxy-auth token pair (Modal dashboard > Settings > Proxy Auth Tokens, or `modal workspace proxy-tokens create`).
# The endpoint rejects requests without these.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Set to 1 to force the local demo provider (sharp colour grade, no AI) even if Modal is configured.
# When MODAL_ENDPOINT_URL is empty the app falls back to demo mode automatically.
DEMO_MODE=
